<nav
  class='secondary-nav'
  aria-label='{{secondaryNavLabel}}'
  hx-boost:inherited="swap:'innerHTML' target:#main-content"
>
  <ul>
    {{#each secondaryNavLinks}}
      <li>
        <a href='{{name}}/index.html' hx-replace-url='?sn={{name}}'>
          {{#if icon}}
            <em-icon path='{{icon}}'></em-icon>
          {{/if}}
          {{label}}
        </a>
      </li>
    {{/each}}
  </ul>
</nav>